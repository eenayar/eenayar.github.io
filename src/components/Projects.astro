---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Get all blog posts
const allPosts = await getCollection('blog');

// Filter out drafts, sort by date, and take first 3
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<section id="projects">
    <div id="inner_section">
        <div class="text animate">
            <h2>Blog</h2>
            <p>
                Archived projects and technical writing.
            </p>
        </div>

        <div class="list_wrapper">
            <div class="list_container">
                <ul style={`--num-items:${posts.length};`}>
                    {posts.map((post, index) => (
                        <li style={`--item-position:${index + 1};`} class="animate">
                            <a href={`/blog/${post.id.replace('/index', '')}/`} class="li-link">
                                {post.data.coverImage && (
                                    <div class="li-cover">
                                        <Image
                                            src={post.data.coverImage}
                                            alt={post.data.title}
                                            width={560}
                                            height={360}
                                            quality={90}
                                            format="webp"
                                        />
                                    </div>
                                )}
                                <div class="li-body">
                                    <h4 class="li-header">
                                        {post.data.title}
                                    </h4>
                                    <div class="li-content">
                                        <p>
                                            {post.data.description || ''}
                                        </p>
                                    </div>
                                    <div class="project_links">
                                        <span>Read article</span>
                                    </div>
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <a href="/blog/" class="view-all-link animate">All articles</a>
    </div>
</section>

<style>
    section {
        background-color: var(--bg-second-section);
        background: var(--gradient-second-section);
    }

    #inner_section {
        display: grid;
        gap: 32px;
        padding: 80px 0px;
    }

    .text {
        display: grid;
        gap: 8px;
        padding-left: 50px;
    }

    .view-all-link {
        text-align: center;
    }

    .text p {
        font-size: var(--step-0);
    }
    h2 {
        font-size: var(--step-3);
    }

    .list_wrapper {
        position: relative;
        border-top: 1px solid hsl(0 0% 15% / 1);
        border-bottom: 1px solid hsl(0 0% 15% / 1);
    }

    ul {
        box-shadow: 0px 0px 10px 0px hsl(0 0% 4% / 1);
    }

    ul:hover {
        box-shadow: 0px 0px 10px 0px hsl(0 0% 8% / 1);
        transition: all 0.3s ease-out;
    }

    li:first-child {
        border-top: none;
    }

    li {
        border-top: 1px solid hsl(0 0% 15% / 1);
        background: hsl(0 0% 4% / 1);
        box-shadow: inset 0px 0px 10px 0px hsla(0, 0%, 8%, 0);

        display: flex;
        flex-direction: row;
        align-items: stretch;
        padding: 0;

        opacity: 0;

        transition: all 0.4s ease-out;
        animation-fill-mode: forwards;
        animation-delay: calc(0.2s * (var(--item-position) - 1));
    }

    .li-cover {
        flex-shrink: 0;
        width: 280px;
        overflow: hidden;
    }

    .li-cover :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .li-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 20px 50px 20px 24px;
        flex: 1;
    }

    .li-link {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        text-decoration: none;
        color: inherit;
        width: 100%;
    }

    .li-content {
        display: grid;
        gap: 12px;
    }

    .li-content p {
        line-height: 1.5;
        color: var(--color-content);
    }

    .li-header {
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .project_links {
        display: flex;
        gap: 16px;
        font-size: var(--step--1);
        padding-top: 4px;
    }

    .project_links span {
        color: var(--color-content);
    }



    li:hover {
        background: hsl(0 0% 6% / 1);
        box-shadow: inset 0px 0px 10px 0px hsl(0 0% 8% / 1);
    }

    li:last-child {
        border-bottom: 1px solid hsl(0 0% 15% / 1);
    }

    @media (max-width: 48rem) {
        #inner_section {
            padding: 50px 0px 50px 0px;
        }
        .text {
            text-align: center;
            padding: 0px clamp(8px, 4vw, 24px);
            align-items: center;
        }

        .li-link {
            flex-direction: column;
        }

        .li-cover {
            width: 100%;
            height: 180px;
        }

        .li-body {
            padding: 16px clamp(12px, 4vw, 24px);
        }
    }
</style>

