---
import { Image } from "astro:assets";
import bg from "../assets/bg.webp";
import NavBar from "./NavBar.astro";
---

<section>
	<div id="inner_section">
		<NavBar />
		<div class="content">
			<div class="text animate">
				<h1>Cloud & DevOps</h1>
				<p>
					An archive of my journey as a self-taught developer, bringing
					together projects and technical articles on cloud infrastructure,
					DevOps, and web application development.
				</p>
			</div>
		</div>

		<Image
			id={"background"}
			src={bg}
			width={bg.width}
			height={bg.height}
			alt="Mountains"
			loading={"eager"}
		/>
	</div>
</section>

<style>
	section {
		background-color: var(--bg-first-section);
		background: var(--gradient-first-section);
	}

	#inner_section {
		height: 600px;
	}

	#background {
		position: absolute;
		top: 0;
		left: 0;
		max-width: var(--max-width);
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.content {
		display: flex;
		gap: 16px;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 10;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			0deg,
			hsl(0deg 0% 4% / 95%),
			hsl(0deg 0% 1% / 95%) 100%
		);
		backdrop-filter: blur(10px);
	}
	.text h1 {
		font-size: var(--step-4); 
	}
	.text p {
		font-size: var(--step-0); 
		max-width: 62ch;
	}
	.text {
		display: grid;
		text-align: center;
		gap: 4px;
		@media (max-width: 40rem) {
			padding: 0px clamp(8px, 4vw, 24px);
		}
	}

</style>
